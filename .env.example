# IBM Bob API key for non-interactive Bob Shell calls (bob_prompt, bob_resume_session).
# Obtain from your Bob administrator or IBM Bob setup.
BOBSHELL_API_KEY=

# Optional: absolute path to the bob executable (default: bob from PATH)
BOB_BIN=/home/<USER>/.local/bin/bob

# Optional: default workspace when tools omit workspace
# BOB_DEFAULT_WORKSPACE=/home/<USER>/path/to/bob-cursor-mcp

# Optional: default Bob chat mode (plan, code, advanced, ask). Default: advanced
# BOB_DEFAULT_CHAT_MODE=advanced

# Optional: subprocess timeout in milliseconds (default: 600000 = 10 minutes)
# BOB_TIMEOUT_MS=600000
